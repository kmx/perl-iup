  /*### check if canvas pointer is present in global hash 'ch_register' */
  ref = hv_fetch(globreg, hkey, strlen(hkey), 0);
  if (ref != NULL)
    if (SvOK(*ref)) { SvREFCNT_dec(ptrSV); return *ref; } /* free local ptrSV (not stored on this path) */

